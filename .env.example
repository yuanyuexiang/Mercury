# 本地开发模板（cp .env.example .env）。生产 .env 由 deploy.sh 自动生成，无需手写。
# 原则：只有密钥和基础设施地址进 env；LLM 在后台「模型配置」页配；
# 调优参数都有代码默认值（完整清单见 packages/domain/config.py）。

DATABASE_URL=postgresql+asyncpg://mercury:mercury@localhost:55432/mercury
REDIS_URL=redis://localhost:6379/0

# 后台登录（本地随意填；生产自动生成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=   # python -c "import bcrypt; print(bcrypt.hashpw(b'密码', bcrypt.gensalt()).decode())" ——值含 $，写入时整体加单引号
JWT_SECRET=dev-only-secret

# 供应商 api_key 的加密主密钥（使用后台「模型配置」前必配）
SETTINGS_ENCRYPTION_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# 真机联调才需要（不配则自动用 LoggingSender 替身，本地照常全链路测试）
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPERATOR_TELEGRAM_CHAT_ID=

# ---- 以下均可选，按需取消注释 ----
# LLM env 兜底（推荐用后台「模型配置」代替）：
#   LLM_API_KEY= / LLM_CHAT_MODEL= / LLM_BASE_URL= / LLM_EMBED_MODEL=
# Google Sheets 同步：
#   GOOGLE_SERVICE_ACCOUNT_JSON= / LEADS_SPREADSHEET_ID=
# 调优（默认值见 config.py）：
#   RAG_MIN_SIMILARITY / RAG_TOP_K / REPLY_DEADLINE_S / DATA_RETENTION_DAYS / LOG_LEVEL / STORAGE_DIR / ALLOW_PRIVATE_LLM_BASE_URL
