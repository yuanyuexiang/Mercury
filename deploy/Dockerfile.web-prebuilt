# 管理后台镜像——预构建产物直拷贝版（CD 提速，§17）。
# cd.yml 的 build job 在 runner 上跑 pnpm build（挂 .next/cache 增量缓存与 pnpm 缓存），
# 把 standalone 产物组装成独立构建上下文后，这里只做拷贝：web 镜像构建从 ~3 分钟降到秒级。
# 运行时布局与 Dockerfile.web 完全一致（standalone 根 + .next/static）；
# 本地或无产物场景仍用 deploy/Dockerfile.web 做全量构建。
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY . .
EXPOSE 3000
CMD ["node", "server.js"]
